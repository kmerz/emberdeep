{
  "name": "emberdeep-web",
  "private": true,
  "version": "0.0.2-crimson",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/copy-dist.mjs",
    "test": "esbuild scripts/test.ts --bundle --platform=node --format=esm --outfile=.smoke.mjs --log-level=error && node .smoke.mjs",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=esm --outfile=.smoke.mjs --log-level=error && node .smoke.mjs",
    "smoke:lobby": "esbuild scripts/smoke-lobby.ts --bundle --platform=node --format=esm --outfile=.smoke.mjs --log-level=error && node .smoke.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
